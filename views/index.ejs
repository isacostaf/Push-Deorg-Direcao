<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Radar Colegiados - MD</title>
    <link rel="shortcut icon" href="/image.png" type="image/x-icon">
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <main class="container">
      <section class="card">
        <header>
          <div>
            <h1>Radar Colegiados - MD</h1>
            <p>Use o radar para identificar representações entre datas e exportar os resultados rapidamente.</p>
          </div>
        </header>

        <div class="aviso-humano">
          Atenção: a análise automática pode conter erros. A verificação humana é indispensável antes de qualquer decisão.
        </div>

        <form method="post" action="/process">
          <div class="form-grid">
            <div class="field">
              <label for="data">Data</label>
              <input id="data" name="data" type="date" value="<%= data %>" required />
            </div>

            <div class="field">
              <button class="primary" type="submit">Verificar resultados</button>
            </div>
          </div>
        </form>

        <div class="cadastro-cta">
          <div>
            <h3>Receba o radar por e-mail</h3>
            <p>Envio diario entre 8:00 e 9:00. Cadastre nome e e-mail para receber o resumo automaticamente.</p>
          </div>
          <button class="secondary" type="button" id="openSignup">Cadastrar e-mail</button>
        </div>

        <% if (erro) { %>
          <div class="msg erro"><%= erro %></div>
        <% } %>

        <% if (aviso) { %>
          <div class="msg aviso"><%= aviso %></div>
        <% } %>

        <% if (runId) { %>
          <div class="actions">
            <a class="btn secondary" href="/download/csv/<%= runId %>">Baixar CSV</a>
            <a class="btn secondary" href="/download/zip/<%= runId %>/alta">Alta probabilidade</a>
            <a class="btn secondary" href="/download/zip/<%= runId %>/baixa">Baixa probabilidade</a>
            <% if (false) { %>
              <form action="/email/<%= runId %>" method="post">
                <button class="primary" type="submit">Enviar e-mail</button>
              </form>
            <% } %>
          </div>
        <% } %>
      </section>

      <% if (rows && rows.length) { %>
        <section class="card">
          <h2>Resultados</h2>
          <p>Verde: Alta probabilidade. <br>Amarelo: Baixa probabilidade.</p>

          <div class="table-wrapper">
            <table>
              <thead>
                <tr>
                  <th>Documento</th>
                  <th>PDF</th>
                  <th>Classificação</th>
                </tr>
              </thead>
              <tbody>
                <% rows.forEach((row) => { %>
                  <% const classe = row.Classificacao === "Alta probabilidade" ? "alta" : row.Classificacao === "Baixa probabilidade" ? "baixa" : ""; %>
                  <tr class="<%= classe %>">
                    <td><%= row.Documento %></td>
                    <td><a href="<%= row.PDF %>" target="_blank" rel="noopener noreferrer">Abrir PDF</a></td>
                    <td><%= row.Classificacao %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <div class="pagination" data-page-size="10">
            <div class="pagination-info" id="paginationInfo"></div>
            <div class="pagination-controls">
              <div class="pagination-size">
                <span class="pagination-label">Por página</span>
                <select id="pageSizeSelect" class="pagination-select" aria-label="Itens por página">
                  <option value="10" selected>10</option>
                  <option value="25">25</option>
                  <option value="50">50</option>
                </select>
              </div>
              <div class="pagination-buttons" id="paginationButtons" aria-label="Paginação"></div>
            </div>
          </div>
        </section>
      <% } %>
    </main>

    <div class="modal" id="signupModal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="signupTitle">
      <div class="modal-card">
        <button class="modal-close" type="button" id="closeSignup" aria-label="Fechar">×</button>
        <h3 id="signupTitle">Cadastro para envio diário</h3>
        <p>
          Informe seus dados para receber e-mails diários entre 8h e 9h.
        </p>
        <p>
          São permitidos apenas endereços de e-mail do Ministério da Defesa.
        </p>
        <form class="modal-form" method="post" action="/subscribe">
          <div class="field">
            <label for="signupName">Nome</label>
            <input
              id="signupName"
              name="name"
              type="text"
              placeholder="Seu nome"
              required
            />
          </div>
          <div class="field">
            <label for="signupEmail">E-mail</label>
            <input
              id="signupEmail"
              name="email"
              type="email"
              placeholder="seu@email.com"
              required
            />
          </div>
          <button class="primary" type="submit">
            Confirmar cadastro
          </button>
        </form>
      </div>
    </div>
    
    <div id="loadingOverlay" class="loading-overlay" aria-hidden="true">
      <div class="loading-card" role="status" aria-live="polite">
        <div class="loading-badge" aria-hidden="true">
          <div class="loading-stars">
            <span class="star s1"></span>
            <span class="star s2"></span>
            <span class="star s3"></span>
            <span class="star s4"></span>
            <span class="star s5"></span>
            <span class="star s6"></span>
          </div>
          <div class="loading-ai">IA</div>
        </div>
        <div class="loading-title">Analisando com IA</div>
        <div class="loading-subtitle">Coletando links, classificando e preparando downloads...</div>
        <div class="loading-bar" aria-hidden="true"><span></span></div>
      </div>
    </div>

    <script>
      (() => {
        const overlay = document.getElementById("loadingOverlay");
        if (overlay) {
          const showLoading = () => {
            overlay.classList.add("is-visible");
            overlay.setAttribute("aria-hidden", "false");
            document.body.classList.add("is-loading");

            document.querySelectorAll('button[type="submit"]').forEach((button) => {
              button.disabled = true;
            });
          };

          document.querySelectorAll("form").forEach((form) => {
            form.addEventListener("submit", () => {
              showLoading();
            });
          });
        }

        const paginationRoot = document.querySelector(".pagination");
        const tbody = document.querySelector(".table-wrapper tbody");
        const infoEl = document.getElementById("paginationInfo");
        const buttonsEl = document.getElementById("paginationButtons");
        const pageSizeSelect = document.getElementById("pageSizeSelect");

        if (!paginationRoot || !tbody || !infoEl || !buttonsEl || !pageSizeSelect) return;

        const allRows = Array.from(tbody.querySelectorAll("tr"));
        if (allRows.length <= 10) {
          paginationRoot.style.display = "none";
          return;
        }

        let pageSize = Number(paginationRoot.dataset.pageSize || pageSizeSelect.value || 10);
        let currentPage = 1;

        const clamp = (n, min, max) => Math.max(min, Math.min(max, n));
        const totalPages = () => Math.max(1, Math.ceil(allRows.length / pageSize));

        const setPage = (page) => {
          currentPage = clamp(page, 1, totalPages());
          render();
        };

        const renderRows = () => {
          const start = (currentPage - 1) * pageSize;
          const end = Math.min(start + pageSize, allRows.length);

          allRows.forEach((row, idx) => {
            row.style.display = idx >= start && idx < end ? "" : "none";
          });

          infoEl.textContent = `Mostrando ${start + 1}–${end} de ${allRows.length}`;
        };

        const createBtn = ({ label, page, disabled, active, ariaLabel }) => {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = `pagination-btn${active ? " is-active" : ""}`;
          btn.textContent = label;
          if (ariaLabel) btn.setAttribute("aria-label", ariaLabel);
          btn.disabled = Boolean(disabled);
          btn.addEventListener("click", () => setPage(page));
          return btn;
        };

        const createDots = () => {
          const span = document.createElement("span");
          span.className = "pagination-dots";
          span.textContent = "…";
          return span;
        };

        const renderButtons = () => {
          const tp = totalPages();
          buttonsEl.innerHTML = "";

          buttonsEl.appendChild(
            createBtn({
              label: "‹",
              page: currentPage - 1,
              disabled: currentPage <= 1,
              ariaLabel: "Página anterior",
            })
          );

          const maxVisible = 5;
          let start = Math.max(1, currentPage - Math.floor(maxVisible / 2));
          let end = start + maxVisible - 1;

          if (end > tp) {
            end = tp;
            start = Math.max(1, end - maxVisible + 1);
          }

          if (start > 1) {
            buttonsEl.appendChild(
              createBtn({ label: "1", page: 1, active: currentPage === 1 })
            );
            if (start > 2) buttonsEl.appendChild(createDots());
          }

          for (let p = start; p <= end; p += 1) {
            buttonsEl.appendChild(
              createBtn({ label: String(p), page: p, active: currentPage === p })
            );
          }

          if (end < tp) {
            if (end < tp - 1) buttonsEl.appendChild(createDots());
            buttonsEl.appendChild(
              createBtn({ label: String(tp), page: tp, active: currentPage === tp })
            );
          }

          buttonsEl.appendChild(
            createBtn({
              label: "›",
              page: currentPage + 1,
              disabled: currentPage >= tp,
              ariaLabel: "Próxima página",
            })
          );
        };

        const render = () => {
          renderRows();
          renderButtons();
        };

        pageSizeSelect.value = String(pageSize);
        pageSizeSelect.addEventListener("change", () => {
          pageSize = Number(pageSizeSelect.value || 10);
          setPage(1);
        });

        render();
      })();

      (() => {
        const modal = document.getElementById("signupModal");
        const openBtn = document.getElementById("openSignup");
        const closeBtn = document.getElementById("closeSignup");

        if (!modal || !openBtn || !closeBtn) return;

        const openModal = () => {
          modal.classList.add("is-visible");
          modal.setAttribute("aria-hidden", "false");
          document.body.classList.add("is-modal-open");
          const firstInput = modal.querySelector("input");
          if (firstInput) firstInput.focus();
        };

        const closeModal = () => {
          modal.classList.remove("is-visible");
          modal.setAttribute("aria-hidden", "true");
          document.body.classList.remove("is-modal-open");
          openBtn.focus();
        };

        openBtn.addEventListener("click", openModal);
        closeBtn.addEventListener("click", closeModal);
        modal.addEventListener("click", (event) => {
          if (event.target === modal) closeModal();
        });
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && modal.classList.contains("is-visible")) {
            closeModal();
          }
        });
      })();
    </script>
  </body>
</html>
